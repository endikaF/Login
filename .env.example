# Copia este archivo a .env (ignorado por git) y rellena los valores. NUNCA subas .env.
# Spring lo carga solo si existe (spring.config.import en application.yml).

# Primer administrador, creado al arrancar si no existe. Sin estas variables no se crea ninguno.
ADMIN_EMAIL=admin@example.com
# Mínimo 12 caracteres. Pon una contraseña propia y única.
ADMIN_PASSWORD=
